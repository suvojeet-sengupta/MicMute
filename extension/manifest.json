{
  "manifest_version": 3,
  "name": "MicMute Ozonetel Connector",
  "version": "1.1.0",
  "description": "Automatically triggers MicMute call recording when Ozonetel call is active",
  "permissions": [
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "*://*.ozonetel.com/*",
    "*://*.dishtv.ozonetel.com/*",
    "http://127.0.0.1:9876/*",
    "http://localhost:9876/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MicMute Connector"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ozonetel.com/*",
        "*://*.dishtv.ozonetel.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
